# ==============================================================================
# Respiratory Sound Denoising & Clinical Visualization (RSDV) Environment Config
# ==============================================================================

# Web UI Access Port (Accessible in browser: http://localhost:PORT or http://<SERVER_IP>:PORT)
PORT=3000

# Backend Service Internal/External Port
BACKEND_PORT=8000

# Network Host Binding (0.0.0.0 allows remote access from server IP and local access)
HOST=0.0.0.0

# Optional: Custom backend URL if running frontend separately
VITE_BACKEND_URL=http://127.0.0.1:8000
